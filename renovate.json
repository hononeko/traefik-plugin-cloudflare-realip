{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Bump Go version in go.mod and group it",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump",
      "groupName": "Go"
    },
    {
      "description": "Internal hononeko/actions: update immediately without release age delay",
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "hononeko/actions",
        "hononeko/actions/**"
      ],
      "matchDepNames": [
        "hononeko/actions",
        "hononeko/actions/**"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Stay on the yaegi minor Traefik embeds; bump it by hand alongside Traefik",
      "matchDepNames": [
        "github.com/traefik/yaegi"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "description": "yaegi version used by the Yaegi CI job",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/validate\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+YAEGI_VERSION: (?<currentValue>\\S+)"
      ]
    }
  ]
}
